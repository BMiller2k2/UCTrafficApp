<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UCTrafficApp.Pages.Email_verification"
             Title="Email verification"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <!-- Header -->
            <Label Text="UC Traffic"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   Margin="0,60,0,10"/>

            <!-- Title -->
            <Label Text="Enter code"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="White"/>

            <!-- Subtitle -->
            <Label Text="Verify your email address via code"
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <!-- Code Input -->
            <Frame CornerRadius="8"
                   HasShadow="False"
                   BorderColor="#E0E0E0"
                   Padding="10,5"
                   Margin="0,0,0,20">
                <Entry x:Name="CodeEntry"
                       Placeholder="******"
                       Keyboard="Numeric"
                       IsPassword="True"
                       BackgroundColor="Transparent"
                       TextColor="White"
                       PlaceholderColor="Gray" />
            </Frame>

            <!-- Continue -->
            <Button Text="Continue"
                    BackgroundColor="Black"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="45"
                    FontAttributes="Bold"
                    Margin="0,0,0,10"
                    Clicked="OnContinueClicked"/>

            <!-- Cancel -->
            <Button Text="Cancel"
                    BackgroundColor="Black"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="45"
                    FontAttributes="Bold"
                    Clicked="OnCancelClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
