<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UCTrafficApp.Pages.Sign_in"
             Title="Sign In"
             BackgroundColor="DarkRed">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="0,60,0,20"
                             HorizontalOptions="Center"
                             VerticalOptions="Start">
            <Label Text="UC Traffic"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="Black"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Sign In Form -->
        <VerticalStackLayout Grid.Row="1"
                             VerticalOptions="Center"
                             Padding="30,0">

            <Label Text="Sign in"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <!-- Username -->
            <Frame CornerRadius="8"
                   HasShadow="False"
                   BorderColor="#E0E0E0"
                   Padding="10,5"
                   Margin="0,0,0,10">
                <Entry x:Name="UsernameEntry"
                       Placeholder="Username"
                       BackgroundColor="Transparent"
                       TextColor="White"
                       PlaceholderColor="Gray" />
            </Frame>

            <!-- Password -->
            <Frame CornerRadius="8"
                   HasShadow="False"
                   BorderColor="#E0E0E0"
                   Padding="10,5"
                   Margin="0,0,0,20">
                <Entry x:Name="PasswordEntry"
                       Placeholder="Password"
                       IsPassword="True"
                       BackgroundColor="Transparent"
                       TextColor="white"
                       PlaceholderColor="Gray" />
            </Frame>

            <!-- Continue Button -->
            <Button Text="Continue"
                    BackgroundColor="Black"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="45"
                    FontAttributes="Bold"
                    Clicked="OnContinueClicked"/>
            <Button Text="Sign UP"
                    BackgroundColor="Black"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="45"
                    FontAttributes="Bold"
                    Clicked="OnSignUpClicked"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
