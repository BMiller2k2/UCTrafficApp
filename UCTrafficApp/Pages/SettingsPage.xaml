<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UCTrafficApp.Pages.SettingsPage"
             Title="Settings"
             BackgroundColor="DarkRed">
             

     <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Button Text="Account"
                    BackgroundColor="Black"
                    TextColor="White"
                    CornerRadius="8"
                    Clicked="OnAccountClicked"/>

            <Button Text="Privacy"
                    BackgroundColor="Black"
                    TextColor="White"
                    CornerRadius="8"
                    Clicked="OnPrivacyClicked"/>

            <Button Text="Preferences"
                    BackgroundColor="Black"
                    TextColor="White"
                    CornerRadius="8"
                    Clicked="OnPreferencesClicked"/>

            <!--<Button Text="About"
                    BackgroundColor="#00A86B"
                    TextColor="White"
                    CornerRadius="8"
                    Clicked="OnAboutClicked"/>-->

            <Button Text="Report an Issue"
                    BackgroundColor="#D62C2C"
                    TextColor="White"
                    CornerRadius="8"
                    Clicked="OnReportIssueClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>