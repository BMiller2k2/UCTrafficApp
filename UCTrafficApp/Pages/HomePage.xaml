<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="UCTrafficApp.Pages.HomePage"
    Title="UC Traffic Map"
    BackgroundColor="DarkRed">

    <!-- 4 rows:
         0 = Welcome header
         1 = Inputs / options
         2 = Favorites list (collapsible)
         3 = Map -->
    <Grid RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="*"
          Padding="12" RowSpacing="8">

        <!-- Row 0: Welcome header -->
        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Label Text="Welcome to UC Traffic"
                   FontSize="24" FontAttributes="Bold"
                   HorizontalOptions="Center" />
            <Label Text="You’re signed in. This is your dashboard."
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Row 1: Inputs, controls, options -->
        <VerticalStackLayout Grid.Row="1" Spacing="8">

            <!-- From/To + Go/Save/Toggle -->
            <Grid ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <!-- Go -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Save -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Toggle -->
                </Grid.ColumnDefinitions>

                <Entry x:Name="FromEntry"
                       Grid.Column="0"
                       Placeholder="From (Cincinnati)"
                       HeightRequest="40" FontSize="Small" />

                <Entry x:Name="ToEntry"
                       Grid.Column="1"
                       Placeholder="To (Cincinnati)"
                       HeightRequest="40" FontSize="Small" />

                <Button Grid.Column="2"
                        Text="Go"
                        HeightRequest="40" WidthRequest="50"
                        BackgroundColor="Black" TextColor="White"
                        Clicked="OnGoClicked" />

                <Button Grid.Column="3"
                        Text="★"
                        HeightRequest="40" WidthRequest="40"
                        BackgroundColor="Black" TextColor="White"
                        Clicked="OnAddFavoriteClicked" />

                <Button x:Name="ToggleFavoritesButton"
                        Grid.Column="4"
                        Text="☰"
                        HeightRequest="40" WidthRequest="40"
                        BackgroundColor="Black" TextColor="White"
                        Clicked="OnToggleFavoritesClicked" />
            </Grid>

            <!-- Options -->
            <StackLayout Orientation="Horizontal" Spacing="10" Margin="5,0,0,0">
                <CheckBox x:Name="AvoidHighwaysCheckbox" IsChecked="False" />
                <Label Text="Avoid Highways" VerticalOptions="Center"
                       FontSize="Small" TextColor="#333" />
            </StackLayout>
        </VerticalStackLayout>

        <!-- Row 2: Favorites (collapsible) -->
        <CollectionView x:Name="FavoritesListView"
                        Grid.Row="2"
                        IsVisible="False"
                        SelectionMode="Single"
                        HeightRequest="180"
                        BackgroundColor="#f0f0f0"
                        Margin="0,0,0,6"
                        SelectionChanged="OnFavoriteSelected">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="1" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" ColumnDefinitions="*,Auto" BackgroundColor="White">
                        <Label Grid.Column="0"
                               Text="{Binding DisplayName}"
                               FontSize="Small"
                               LineBreakMode="TailTruncation"
                               VerticalTextAlignment="Center" />
                        <Button Grid.Column="1"
                                Text="X"
                                HeightRequest="30" WidthRequest="30"
                                BackgroundColor="#D9534F" TextColor="White"
                                CornerRadius="5"
                                CommandParameter="{Binding .}"
                                Clicked="OnDeleteFavoriteClicked" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Row 3: Map -->
        <WebView x:Name="MapWebView"
                 Grid.Row="3"
                 HorizontalOptions="FillAndExpand"
                 VerticalOptions="FillAndExpand" />
    </Grid>
</ContentPage>
