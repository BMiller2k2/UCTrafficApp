<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="UCTrafficApp.Pages.HomePage"
    Title="UC Traffic Map"
    BackgroundColor="DarkRed">

    <!-- 5 rows:
         0 = Welcome header
         1 = Live traffic data
         2 = Inputs / options
         3 = Favorites list (collapsible)
         4 = Map -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" ColumnDefinitions="*"
          Padding="12" RowSpacing="8">

        <!-- Row 0: Welcome header -->
        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Label Text="Welcome to UC Traffic"
                   FontSize="24" FontAttributes="Bold"
                   HorizontalOptions="Center" />
            <Label Text="You’re signed in. This is your dashboard."
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Row 1: Live Traffic Data -->
        <Frame Grid.Row="1" BorderColor="Orange" CornerRadius="10" Padding="12" HasShadow="True">
            <VerticalStackLayout Spacing="8">
                <Label Text="Live Traffic Status" FontSize="18" FontAttributes="Bold" TextColor="White" />

                <!-- Loading Indicator -->
                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" 
                                 Color="Orange" Margin="0,10" />

                <!-- Status Message -->
                <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="#FFD700" 
                       HorizontalOptions="Center" />

                <!-- Traffic Data List -->
                <CollectionView ItemsSource="{Binding TrafficDataList}" HeightRequest="200">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BorderColor="White" CornerRadius="8" Padding="12" Margin="0,4" HasShadow="True">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding RouteName, StringFormat='Route: {0}'}" 
                                           FontSize="14" FontAttributes="Bold" TextColor="White" />
                                    <Label Text="{Binding FromLocation, StringFormat='From: {0}'}" 
                                           FontSize="12" TextColor="#E0E0E0" />
                                    <Label Text="{Binding ToLocation, StringFormat='To: {0}'}" 
                                           FontSize="12" TextColor="#E0E0E0" />

                                    <!-- Traffic Status with Color Coding -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                        <Label Grid.Column="0" Text="{Binding TrafficStatus}" FontSize="12" FontAttributes="Bold" TextColor="White" />
                                        <Label Grid.Column="1" Text="{Binding EstimatedTravelMinutes, StringFormat='{0} min'}" 
                                               FontSize="12" FontAttributes="Bold" TextColor="#90EE90" />
                                    </Grid>

                                    <Label Text="{Binding TrafficDescription}" FontSize="11" TextColor="#B0B0B0" 
                                           LineBreakMode="WordWrap" />
                                    <Label Text="{Binding LastUpdated, StringFormat='Updated: {0:HH:mm:ss}'}" 
                                           FontSize="10" TextColor="#808080" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Refresh Button -->
                <Button Text="Refresh Traffic Data" 
                        Command="{Binding RefreshCommand}"
                        BackgroundColor="Orange" TextColor="White" 
                        CornerRadius="8" Padding="10" FontAttributes="Bold" />
            </VerticalStackLayout>
        </Frame>

        <!-- Row 2: Inputs, controls, options -->
        <VerticalStackLayout Grid.Row="2" Spacing="8">

            <!-- From/To + Go/Save/Toggle -->
            <Grid ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <!-- Go -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Save -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Toggle -->
                </Grid.ColumnDefinitions>

                <Entry x:Name="FromEntry"
                       Grid.Column="0"
                       Placeholder="From (Cincinnati)"
                       HeightRequest="40" FontSize="Small" TextColor="White" />

                <Entry x:Name="ToEntry"
                       Grid.Column="1"
                       Placeholder="To (Cincinnati)"
                       HeightRequest="40" FontSize="Small" TextColor="White" />

                <Button Grid.Column="2"
                        Text="Go"
                        HeightRequest="40" WidthRequest="50"
                        BackgroundColor="Black" TextColor="White"
                        Clicked="OnGoClicked" />

                <Button Grid.Column="3"
                        Text="★"
                        HeightRequest="40" WidthRequest="40"
                        BackgroundColor="Black" TextColor="White"
                        Clicked="OnAddFavoriteClicked" />

                <Button x:Name="ToggleFavoritesButton"
                        Grid.Column="4"
                        Text="☰"
                        HeightRequest="40" WidthRequest="40"
                        BackgroundColor="Black" TextColor="White"
                        Clicked="OnToggleFavoritesClicked" />
            </Grid>

            <!-- Options -->
            <StackLayout Orientation="Horizontal" Spacing="10" Margin="5,0,0,0">
                <CheckBox x:Name="AvoidHighwaysCheckbox" IsChecked="False" Background="Black" />
                <Label Text="Avoid Highways" VerticalOptions="Center"
                       FontSize="Small" TextColor="White" />
            </StackLayout>
        </VerticalStackLayout>

        <!-- Row 3: Favorites (collapsible) -->
        <CollectionView x:Name="FavoritesListView"
                        Grid.Row="3"
                        IsVisible="False"
                        SelectionMode="Single"
                        HeightRequest="180"
                        BackgroundColor="#f0f0f0"
                        Margin="0,0,0,6"
                        SelectionChanged="OnFavoriteSelected">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="1" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" ColumnDefinitions="*,Auto" BackgroundColor="White">
                        <Label Grid.Column="0"
                               Text="{Binding DisplayName}"
                               FontSize="Small"
                               LineBreakMode="TailTruncation"
                               VerticalTextAlignment="Center" />
                        <Button Grid.Column="1"
                                Text="X"
                                HeightRequest="30" WidthRequest="30"
                                BackgroundColor="#D9534F" TextColor="White"
                                CornerRadius="5"
                                CommandParameter="{Binding .}"
                                Clicked="OnDeleteFavoriteClicked" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Row 4: Map -->
        <WebView x:Name="MapWebView"
                 Grid.Row="4"
                 HorizontalOptions="FillAndExpand"
                 VerticalOptions="FillAndExpand" />
    </Grid>
</ContentPage>
