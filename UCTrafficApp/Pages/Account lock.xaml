<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UCTrafficApp.Pages.Account_lock"
             Title="Account lock"
             BackgroundColor="White">
    <VerticalStackLayout Padding="30" Spacing="16">
        <Label Text="UC Traffic" FontSize="24" FontAttributes="Bold"
               HorizontalOptions="Center" Margin="0,60,0,10" />
        <Label x:Name="MessageLabel"
               TextColor="Red" FontAttributes="Bold"
               HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
        <Label x:Name="CountdownLabel"
               TextColor="Red" FontAttributes="Bold"
               HorizontalOptions="Center" />
        <Button x:Name="ContinueButton" Text="Continue"
                BackgroundColor="Black" TextColor="White"
                CornerRadius="8" HeightRequest="45"
                Clicked="OnContinueClicked" IsEnabled="False"/>
    </VerticalStackLayout>
</ContentPage>
