<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UCTrafficApp.Pages.ReportIssuePage"
             Title="Report an Issue">

    <VerticalStackLayout Padding="20" Spacing="14">
        <Label Text="Report an Issue"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center" />

        <Frame BackgroundColor="#E9E3EF" CornerRadius="8" Padding="10">
            <VerticalStackLayout Spacing="8">
                <Label Text="Input" FontSize="12" TextColor="Gray"/>
                <Editor x:Name="IssueEditor"
                        HeightRequest="220"
                        Placeholder="Type your issue here..." />
                <Label Text="Supporting text" FontSize="11" TextColor="Gray"/>
            </VerticalStackLayout>
        </Frame>

        <Button Text="SUBMIT"
                HorizontalOptions="End"
                Clicked="Submit_Clicked" />
    </VerticalStackLayout>
</ContentPage>
