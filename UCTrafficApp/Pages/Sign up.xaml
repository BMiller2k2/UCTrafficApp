<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UCTrafficApp.Pages.Sign_up"
             Title="Sign up"
             BackgroundColor="DarkRed">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <!-- Header -->
            <Label Text="UC Traffic"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   Margin="0,60,0,10"/>

            <!-- Title -->
            <Label Text="Create an account"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="Black"/>

            <!-- Subtitle -->
            <Label Text="Enter your email to sign up for this app"
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <!-- Email -->
            <Frame CornerRadius="8"
                   HasShadow="False"
                   BorderColor="#E0E0E0"
                   Padding="10,5"
                   Margin="0,0,0,10">
                <Entry x:Name="EmailEntry"
                       Placeholder="Username"
                       Keyboard="Email"
                       BackgroundColor="Transparent"
                       TextColor="white"
                       PlaceholderColor="Gray" />
            </Frame>

            <!-- Password -->
            <Frame CornerRadius="8"
                   HasShadow="False"
                   BorderColor="#E0E0E0"
                   Padding="10,5"
                   Margin="0,0,0,20">
                <Entry x:Name="PasswordEntry"
                       Placeholder="Password"
                       IsPassword="True"
                       BackgroundColor="Transparent"
                       TextColor="White"
                       PlaceholderColor="Gray" />
            </Frame>

            <!-- Continue Button -->
            <Button Text="Continue"
                    BackgroundColor="Black"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="45"
                    FontAttributes="Bold"
                    Margin="0,0,0,10"
                    Clicked="OnContinueClicked"/>

            <!-- Terms -->
            <Label Text="By clicking continue, you agree to our Terms of Service and Privacy Policy."
                   FontSize="12"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap"
                   Margin="20,10,20,40"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
