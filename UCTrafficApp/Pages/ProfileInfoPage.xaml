<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UCTrafficApp.Pages.ProfileInfoPage"
             Title="Profile Info">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- Avatar -->
            <Frame WidthRequest="72" HeightRequest="72"
                   CornerRadius="36"
                   Padding="0"
                   HasShadow="False"
                   BackgroundColor="#E6E0EC"
                   HorizontalOptions="Start">
                <Label Text="👤"
                       FontSize="34"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>
            </Frame>

            <!-- Menu -->
            <VerticalStackLayout Spacing="10">

                <Frame BackgroundColor="#E9E3EF" CornerRadius="8" Padding="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="My Profile" FontSize="16"/>
                        <Label Text=">" Grid.Column="1"/>
                    </Grid>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="MyProfile_Tapped"/>
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame BackgroundColor="#E9E3EF" CornerRadius="8" Padding="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Settings" FontSize="16"/>
                        <Label Text=">" Grid.Column="1"/>
                    </Grid>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Settings_Tapped"/>
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame BackgroundColor="#E9E3EF" CornerRadius="8" Padding="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Notifications" FontSize="16"/>
                        <Label Text=">" Grid.Column="1"/>
                    </Grid>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Notifications_Tapped"/>
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame BackgroundColor="#E9E3EF" CornerRadius="8" Padding="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="FAQ" FontSize="16"/>
                        <Label Text=">" Grid.Column="1"/>
                    </Grid>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="FAQ_Tapped"/>
                    </Frame.GestureRecognizers>
                </Frame>

            </VerticalStackLayout>

            <!-- Support box -->
            <Frame BackgroundColor="#F0F0F0" CornerRadius="10" Padding="14" Margin="0,8,0,0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="UC Traffic Support" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                    <Label Text="For bug inquiries contact: uctraffic@gmail.com"
                           FontSize="12"
                           TextColor="Gray"
                           HorizontalTextAlignment="Center"/>

                    <Button Text="Logout" TextColor="Red" Clicked="Logout_Clicked"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
